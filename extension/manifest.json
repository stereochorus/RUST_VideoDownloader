{
  "manifest_version": 3,
  "name": "media_downloader",
  "version": "0.1.0",
  "description": "Click a video, get a Download button. Downloads run in the local mdl-daemon (pause/resume).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html", "default_title": "media_downloader" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
